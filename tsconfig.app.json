{
  "compilerOptions": {
    "target": "ES2020",  // Cette ligne est correcte pour `import.meta`
    "module": "ESNext",  // Assurez-vous d'utiliser "ESNext" ou "ES2020"
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true
  },
  "include": [
    "src",
    "module-patch.d.ts",
    "node_modules/vitest/globals.d.ts" // On le garde ici car tu utilises Vitest
  ]
}
