{
    "extends": [
        "stylelint-config-standard",
        "stylelint-config-prettier"
    ],
    "plugins": [
        "stylelint-order"
    ],
    "rules": {
        "order/properties-alphabetical-order": true,
        "number-leading-zero": "never",
        "no-empty-source": null,
        "selector-class-pattern": null,
        "keyframes-name-pattern": null,
        "indentation": [
            2,
            {
                "baseIndentLevel": 1
            }
        ]
    }
}